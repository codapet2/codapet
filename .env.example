# Supabase (server only — never expose the service role key to the browser)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Reply.io (Settings → API Key)
REPLY_API_KEY=
REPLY_SEQUENCE_ID=
# Optional: route by quiz "reason", e.g. {"diagnosis":"12345","older":"67890"}
REPLY_SEQUENCE_ID_BY_REASON=

# Meta Pixel + Conversions API
NEXT_PUBLIC_META_PIXEL_ID=
META_CAPI_TOKEN=
# Optional: Meta Events Manager test code while QA-ing CAPI
META_TEST_EVENT_CODE=

# Protects /api/cron/reply-retry (Vercel sends it as a Bearer token)
CRON_SECRET=

# Feature flag: show "Skip for now" on the email screen
NEXT_PUBLIC_ALLOW_SKIP=false

# Where the funnel hands off
NEXT_PUBLIC_QOL_URL=https://www.codapet.com/quality-of-life-scale
